--- a/runtime/hsa-runtime/core/util/utils.h
+++ b/runtime/hsa-runtime/core/util/utils.h
@@ -66,6 +66,30 @@
 #if defined(_MSC_VER) && (defined(_M_IX86) || defined(_M_X64))
 #include "intrin.h"
 #endif
+#if !defined(__i386__) && !defined(__x86_64__) && !defined(_M_IX86) && !defined(_M_X64)
+// Portable stand-ins for the x86 helpers used throughout ROCR (sfence for WC
+// flush ordering, pause in spin loops, clflush in FlushCpuCache).
+static inline __attribute__((always_inline)) void _mm_sfence(void) {
+  __sync_synchronize();
+}
+static inline __attribute__((always_inline)) void _mm_mfence(void) {
+  __sync_synchronize();
+}
+static inline __attribute__((always_inline)) void _mm_pause(void) {
+#if defined(__aarch64__)
+  __asm__ __volatile__("yield" ::: "memory");
+#else
+  __asm__ __volatile__("" ::: "memory");
+#endif
+}
+static inline __attribute__((always_inline)) void _mm_clflush(const void *p) {
+#if defined(__aarch64__)
+  __asm__ __volatile__("dc civac, %0" : : "r"(p) : "memory");
+#else
+  (void)p;
+#endif
+}
+#endif
 
